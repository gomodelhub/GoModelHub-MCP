{
  "name": "gomodelhub-3d-mcp",
  "version": "1.3.1",
  "description": "MCP server for GoModelHub 3D generation API (stdio local + Streamable HTTP remote)",
  "type": "module",
  "bin": {
    "gomodelhub-3d-mcp": "./src/index.js",
    "gomodelhub-3d-mcp-http": "./src/http-server.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http-server.js",
    "inspector": "npx @modelcontextprotocol/inspector node src/index.js",
    "install:global": "npm install && npm install -g ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelouer/GoModelHub-MCP.git"
  },
  "homepage": "https://login.gomodelhub.com/docs#threed-mcp",
  "bugs": {
    "url": "https://github.com/kelouer/GoModelHub-MCP/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "keywords": [
    "mcp",
    "3d",
    "gomodelhub",
    "modelcontextprotocol",
    "streamable-http"
  ],
  "license": "MIT"
}
